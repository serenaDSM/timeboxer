{
  "name": "timeboxer",
  "private": true,
  "version": "4.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:child": "VITE_TIMEBOXER_CLIENT=child vite build --outDir dist-child",
    "build:parent-preview": "VITE_TIMEBOXER_CLIENT=parent vite build --outDir dist-parent",
    "lint": "eslint .",
    "test": "node --test test/*.test.js",
    "preview": "vite preview",
    "mac:test": "swift test --package-path macos/TimeBoxerMac",
    "mac:build": "bash macos/TimeBoxerMac/scripts/build-app.sh",
    "ios:build": "xcodebuild -project ios/TimeBoxerParent/TimeBoxerParent.xcodeproj -scheme TimeBoxerParent -sdk iphonesimulator -configuration Debug -derivedDataPath /private/tmp/timeboxer-parent-derived CODE_SIGNING_ALLOWED=NO build"
  },
  "dependencies": {
    "lucide-react": "^0.511.0",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.1.18",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.1.18",
    "vite": "^7.3.3"
  }
}
